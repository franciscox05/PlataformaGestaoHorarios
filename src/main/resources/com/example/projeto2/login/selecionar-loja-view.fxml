<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-shell" stylesheets="@login.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projeto2.DESKTOP.SelecionarLojaController">
    <children>
        <Region styleClass="login-backdrop-image" />
        <Region styleClass="login-backdrop-overlay" />

        <VBox alignment="CENTER" maxWidth="500.0" prefWidth="500.0" spacing="22.0" styleClass="login-card">
            <padding>
                <Insets bottom="42.0" left="56.0" right="56.0" top="42.0" />
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="titulo-levis" text="LEVI'S" />
                        <Label styleClass="titulo-registado" text="&#174;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="login-card-tag" text="PORTAL INTERNO" />
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="login-card-title" text="Seleciona a loja" />
                        <Label styleClass="subtitulo-login" text="Tens vínculo ativo a mais do que uma loja. Escolhe onde vais trabalhar nesta sessão." wrapText="true" />
                    </children>
                </VBox>

                <ListView fx:id="listaLojas" prefHeight="220.0" maxWidth="420.0" />

                <Label fx:id="lblErroSelecao" managed="false" maxWidth="420.0" styleClass="erro-login" visible="false" wrapText="true" />

                <Button fx:id="btnConfirmarLoja" defaultButton="true" disable="true" maxWidth="420.0" onAction="#onConfirmarClick" styleClass="botao-login" text="CONTINUAR" />
            </children>
        </VBox>

        <Button onAction="#onFecharAplicacaoClick" styleClass="login-close-button" text="Fechar aplicação" StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets right="38.0" top="26.0" />
            </StackPane.margin>
        </Button>
    </children>
</StackPane>
